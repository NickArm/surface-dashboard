# Auto detect text files and perform LF normalization
* text=auto

# Custom for Visual Studio
*.cs     diff=csharp
*.sln    merge=union
*.csproj merge=union
*.vbproj merge=union
*.fsproj merge=union
*.dbproj merge=union

# Custom for Node.js
*.js     diff=javascript
*.jsx    diff=javascript
*.ts     diff=typescript
*.tsx    diff=typescript
*.json   diff=json

# Custom for CSS
*.css    diff=css

# Custom for HTML
*.html   diff=html
*.htm    diff=html

# Custom for Markdown
*.md     diff=markdown

# Custom for package files
package.json    diff=json
package-lock.json diff=json
yarn.lock       diff=yaml

# Binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.mov    binary
*.mp4    binary
*.mp3    binary
*.flv    binary
*.fla    binary
*.swf    binary
*.gz     binary
*.zip    binary
*.7z     binary
*.ttf    binary
*.eot    binary
*.woff   binary
*.woff2  binary
*.pyc    binary
*.pdf    binary
*.exe    binary
*.dll    binary
*.so     binary
*.dylib  binary

# Files to ignore
.DS_Store
Thumbs.db
*.log
*.tmp
*.temp
node_modules/
build/
dist/
out/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# LFS files (if needed in the future)
# *.psd filter=lfs diff=lfs merge=lfs -text
